{
  "name": "aliya-ai",
  "version": "1.0.0",
  "description": "Local-first tool that helps developers understand any GitHub repository in seconds",
  "main": "server/index.js",
  "files": [
    "bin",
    "server",
    "client/dist",
    "package.json"
  ],
  "bin": {
    "aliya-ai": "./bin/aliya-ai.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "build": "npm run build --prefix client",
    "dev": "concurrently -k \"ALIYA_SKIP_OPEN=1 NODE_ENV=development PORT=3001 node server/index.js\" \"npm run dev --prefix client\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "open": "^11.0.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "yargs": "^17.7.1"
  }
}
