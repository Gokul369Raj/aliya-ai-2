{
  "name": "aliya-ai",
  "version": "1.0.0",
  "description": "Local-first tool that helps developers understand any GitHub repository in seconds",
  "main": "server/index.js",
  "files": [
    "bin",
    "server",
    "client/dist",
    "package.json"
  ],
  "bin": {
    "aliya-ai": "./bin/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/cli.js serve",
    "dev": "node scripts/dev.js",
    "build": "npm run build --prefix client",
    "preview": "npm run build && node bin/cli.js serve",
    "postinstall": "node bin/cli.js prepare",
    "prepack": "npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "open": "^11.0.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "yargs": "^17.7.1"
  }
}
